# GROMACS run intermediates
*.trr        # full-precision trajectory, can be huge
*.xtc        # compressed trajectory, still large
*.edr        # energy file
*.cpt        # checkpoint
*.tpr        # binary run input — regenerable from .mdp + .gro + .top
#*.gro       # NOT ignored - some are inputs!
#*.top       # NOT ignored - inputs!
#*.itp       # NOT ignored - inputs!
#*.mdp       # NOT ignored - inputs!

# GROMACS log/output files
*.xvg        # analysis output — see note below
mdout.mdp    # GROMACS auto-generated copy of effective mdp
\#*\#        # GROMACS backup files (literally hashes around filename)
step*.pdb    # GROMACS error dumps

# Gaussian
*.chk        # checkpoint, large, regenerable
*.rwf        # read-write file, scratch
*.int        # integral file
*.d2e
*.skr
fort.7

# Gaussian outputs — judgment call
*.out       # the actual results — probably keep these in data/
*.dat
*.fchk

# --- Compiled binaries ---

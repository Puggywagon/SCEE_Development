def build_df(i,T,p,dipole,std_dipole):
    data = {
        'Replica': i,
        'Temperature': T,
        'Pressure': p,
        'Dipole Moment': dipole,
        'stdev dipole': std_dipole
    },
    df=pd.DataFrame(data)
    return df

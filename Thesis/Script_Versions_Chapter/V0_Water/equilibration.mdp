integrator               = sd
tinit                    = 0
dt                       = 0.002
nsteps                   = 2500000
nstxout                  = 50000
nstvout                  = 50000
nstfout                  = 0
nstlog                   = 50000
nstenergy                = 1000
nstxtcout                = 1000
rlist                    = 1.2
coulombtype              = PME
rcoulomb                 = 1.2
fourierspacing           = 0.1
pme_order                = 4
vdwtype			 = Cut-off
vdw_modifier		 = Potential-switch
rvdw-switch              = 1.0
rvdw                     = 1.1
DispCorr                  = EnerPres
tc_grps                  = system
tau_t                    = 2.0
ref_t                    = 298
Pcoupl                   = Parrinello-Rahman
tau_p                    = 1.0
compressibility          = 4.5e-05
ref_p                    = 1.0 
;free_energy              = yes
;init_lambda              = 0.00
;delta_lambda             = 0
;sc_alpha                 =0.5
;sc-power                 =1.0
;sc-sigma                 = 0.3 
gen_vel                  = yes
gen_temp                 = 298
gen_seed                 = -1
constraints		 = all-bonds
;constraints              = hbonds
;couple-intramol = no
;couple-moltype = MBU
;couple-lambda0 = vdw
;couple-lambda1 = none

